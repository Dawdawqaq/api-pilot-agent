# 复制为 .env 后填写空值。不要提交包含真实凭证的 .env。
APP_PORT=28080

DB_URL=jdbc:mysql://localhost:3306/dochelper?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=dochelper
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SPRING_PROFILES_ACTIVE=docker,deepseek

# 使用至少 32 字节随机值；首次部署后必须稳定保存。
SECRET_STORE_MASTER_KEY=

QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_URL=http://localhost:6333

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dochelper-files

AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_CHAT_MODEL=deepseek-flash
# deterministic-local 仅用于工程调试；语义检索请配置供应商支持的 Embedding 模型。
AI_EMBEDDING_MODEL=deterministic-local
# 留空时，Embedding 地址和密钥继承 Chat 配置。
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=

# Docker Compose 提供基础设施默认连接；真实模型启动前需填写 AI_API_KEY 与稳定的 SECRET_STORE_MASTER_KEY。
# 本文件的 Profile 用于 Compose；裸机启动请显式使用 local,deepseek，或使用 start-real-local.ps1。

# DocHelper 独立 Compose 的宿主机应用端口，避免与 JApiServer、Luminous 冲突。
APP_PORT=28080

DB_URL=jdbc:mysql://localhost:3306/dochelper?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=dochelper
DB_PASSWORD=<your-database-password>

SPRING_PROFILES_ACTIVE=docker,deepseek


# 至少 32 字节随机值，部署后必须保持稳定，否则重启后无法恢复运行时凭据。
SECRET_STORE_MASTER_KEY=<your-secret-store-master-key>


QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_URL=http://localhost:6333

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=<your-minio-access-key>
MINIO_SECRET_KEY=<your-minio-secret-key>
MINIO_BUCKET=dochelper-files

AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_CHAT_MODEL=deepseek-flash
# 向量模型配置：默认 deterministic-local 使用本地确定性回退；配置真实模型（如 text-embedding-3-small、text-embedding-v4 等）可开启真实 RAG
AI_EMBEDDING_MODEL=deterministic-local
# 可选：独立向量服务地址与密钥（若不配置则默认继承 AI_BASE_URL 与 AI_API_KEY）
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_DIMENSIONS=
